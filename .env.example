# ==============================================================================
# DEVENGERS MAIL ENGINE - CONFIGURATION
# ==============================================================================
# Domain: devengers.org (Purchased from Spaceship)
# Outgoing SMTP: Brevo Free Tier (Guaranteed 300 emails/day completely free)
# Incoming Webmail: Zoho Mail Free Tier (For receiving replies & reading inboxes)
# ==============================================================================

# Recommended: Brevo SMTP Relay (Free 300 emails/day, no credit card required)
# 1. Sign up at https://www.brevo.com
# 2. Go to Senders & IP -> Senders -> Add "event@devengers.org"
# 3. Go to SMTP & API -> Generate SMTP Key
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USE_TLS=true
SMTP_USER=your_brevo_account_login_email
SMTP_PASSWORD=your_brevo_smtp_master_key

# ------------------------------------------------------------------------------
# Alternative: Zoho Mail / ZeptoMail (Requires Zoho Mail Lite or ZeptoMail account)
# Uncomment below if you have a paid Zoho Mail Lite ($1/mo) or ZeptoMail account:
# SMTP_HOST=smtppro.zoho.in
# SMTP_PORT=465
# SMTP_USE_SSL=true
# SMTP_USE_TLS=false
# SMTP_USER=event@devengers.org
# SMTP_PASSWORD=your_zoho_app_password
# ------------------------------------------------------------------------------

# Brand & Routing
SENDER_NAME=Devengers Events
SENDER_EMAIL=event@devengers.org
REPLY_TO_EMAIL=support@devengers.org

# Sending Quota & Rate Limiting (300 Daily Free Service Cap)
DAILY_SEND_LIMIT=300
SEND_DELAY_SECONDS_MIN=5.0
SEND_DELAY_SECONDS_MAX=10.0
BATCH_SIZE=25
BATCH_PAUSE_SECONDS=30.0

# Storage Paths
DATABASE_PATH=devengers_mail.db
UPLOAD_DIR=uploads

# Operational Safety
# Set DRY_RUN=false to enable real live transmission
DRY_RUN=false
DEBUG=false
