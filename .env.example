# ==============================================================================
# DEVENGERS MAIL ENGINE - CONFIGURATION
# ==============================================================================
# Domain: devengers.org (Purchased from Spaceship)
# Email Host: Zoho Mail (Free Tier / ZeptoMail / Zoho SMTP)
# ==============================================================================

# Zoho SMTP Credentials
# NOTE: If your Zoho account was registered on zoho.in (India), use smtppro.zoho.in or smtp.zoho.in
# For global (zoho.com), use smtp.zoho.com or smtppro.zoho.com
SMTP_HOST=smtppro.zoho.in
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_USER=event@devengers.org
# Generate an App-Specific Password in Zoho:
# Zoho Account -> Security -> App Passwords -> Generate New Password
SMTP_PASSWORD=your_zoho_app_password_here

# Brand & Routing
SENDER_NAME=Devengers Events
SENDER_EMAIL=event@devengers.org
REPLY_TO_EMAIL=support@devengers.org

# Sending Quota & Rate Limiting (Zoho Free Tier Safe Limits)
DAILY_SEND_LIMIT=300
SEND_DELAY_SECONDS_MIN=5.0
SEND_DELAY_SECONDS_MAX=10.0
BATCH_SIZE=25
BATCH_PAUSE_SECONDS=30.0

# Database & Storage
DATABASE_PATH=devengers_mail.db
UPLOAD_DIR=uploads

# Operational Safety
# Set DRY_RUN=true to test parsing, rendering, and queue simulation without sending real emails
DRY_RUN=false
DEBUG=false
